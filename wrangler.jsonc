{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pegandekan-mail",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "MAIL_DOMAIN": "pegandekan.web.id"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pegandekan-mail",
      "database_id": "c62fefeb-1b97-4a03-9a19-21b5109d3bdd",
      "migrations_dir": "migrations"
    }
  ]
}
